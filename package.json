{
  "name": "llm-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm --filter @llm-chat/server dev\" \"pnpm --filter @llm-chat/web dev\"",
    "build": "pnpm --filter @llm-chat/web build && pnpm --filter @llm-chat/server build",
    "start": "pnpm --filter @llm-chat/server start",
    "test": "vitest run",
    "test:web:budget": "node scripts/test-web-budget.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test:web:budget && pnpm test:coverage && pnpm build"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.2.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
